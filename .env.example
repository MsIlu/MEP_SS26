LITELLM_BASE_URL=http://141.19.141.155:4000
LITELLM_API_KEY=HIER_API_KEY_EINTRAGEN
LITELLM_MODEL=medgemma:27b

#replace 'Database_URL' to the actual databse URL.
#The database URL is shared separately within the team (e.g. Discord).
#DATABASE_URL=Database_URL

#Required for JWT login tokens. Use a long random value in deployment.
SECRET_KEY=HIER_SECRET_KEY_EINTRAGEN

#Optional: set to true only when you want verbose SQL logs during local debugging.
SQL_ECHO=false

# Per-call model routing (optional): override the model used for specific LLM calls.
# Use a faster/smaller model for non-medical tasks to reduce GPU queue pressure.
# Supported keys: CAREENA4_TOPIC_LABEL_MODEL, CAREENA4_ENTRY_MODEL,
#                 CAREENA4_UNDERSTANDING_MODEL, CAREENA4_EXTRACTION_MODEL
#CAREENA4_TOPIC_LABEL_MODEL=llama3.2:latest

# In case you want to use a local llm:
#LITELLM_BASE_URL=http://localhost:11434/v1
#LITELLM_API_KEY=ollama
#LITELLM_MODEL=medgemma:4b
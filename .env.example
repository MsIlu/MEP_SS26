LITELLM_BASE_URL=HIER_BASE_URL_EINTRAGEN
LITELLM_API_KEY=HIER_API_KEY_EINTRAGEN
LITELLM_MODEL=medgemma:27b
# Local frontend origins are allowed through the regex below.
CORS_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Remove the '#' in line 7 and replace 'Database_URL' to the actual databse URL.
# Teh database URL is shared separately within the team (e.g. Discord).

# DATABASE_URL=Database_URL
SECRET_KEY=HIER_SECRET_KEY_EINTRAGEN

